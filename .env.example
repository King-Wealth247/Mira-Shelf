# ============================================================================
# Mira-Shelf — environment template. Copy to .env.* and fill in locally.
# This file contains PLACEHOLDERS ONLY. Never put real secrets here.
# ============================================================================

# --- Environment selector (guards seed scripts) ---
APP_ENV=development                     # development | staging | production

# --- Supabase (mobile app build — anon key only) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# --- Supabase (server-side / operator scripts ONLY — never in the app build) ---
# Provided through the shell / Secrets Manager / SSM at runtime, not committed.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_SIDE_ONLY

# --- Dev seed accounts (local/isolated only; must be undefined in staging/prod) ---
DEV_SEED_PASSWORD=REPLACE_LOCAL_ONLY    # Section 10.4 — local password is 12345
DEV_PROJECT_REFS=                       # comma-separated allowlisted project refs for seeding
PRODUCTION_PROJECT_REF=                 # production ref the seed guard must refuse

# --- Super Admin bootstrap (operator shell only) ---
SUPER_ADMIN_EMAIL=
# SUPER_ADMIN one-time password is passed via shell env at bootstrap time, not stored here.

# --- Existing AI integration (resolved after DP-1; keep server-side only) ---
AI_PROVIDER=TBD_AFTER_DP1
AI_API_BASE=
AI_API_KEY=REPLACE_SERVER_SIDE_ONLY
# Pattern B only: shared secret between ai-chat Edge Function and the EC2 adapter
AI_ADAPTER_URL=
AI_ADAPTER_SHARED_SECRET=REPLACE_SERVER_SIDE_ONLY

# --- EC2 companion / deployment (DP-5) ---
COMPANION_DOMAIN=
SMTP_PROVIDER=TBD_AFTER_DP5

# --- Optional: embeddings (DP-4) ---
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
